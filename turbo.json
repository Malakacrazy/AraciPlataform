{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "generate": {
      "cache": false,
      // O turbo 2.x roda cada task com o ambiente FILTRADO (envMode
      // "strict" é o padrão): variável que não estiver declarada aqui
      // simplesmente não existe pro processo filho, mesmo estando setada
      // em quem chamou. `prisma generate` carrega prisma.config.ts, que
      // faz env("DATABASE_URL") e aborta com PrismaConfigEnvError sem
      // ela. Achado rodando `docker build` de verdade -- e o mesmo bug
      // valia pro .github/workflows/ci.yml, que setava DATABASE_URL no
      // job e via ela ser filtrada aqui do mesmo jeito.
      // Nenhum destes comandos conecta em banco: a URL só precisa
      // existir e ter forma válida pra config resolver.
      "env": ["DATABASE_URL"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      // Achado da auditoria: sem declarar essas variáveis aqui, o cache
      // do turbo não sabe que o build do apps/web depende delas -- um
      // acerto de cache podia publicar o bundle com o
      // NEXT_PUBLIC_GOOGLE_CLIENT_ID de uma execução anterior (valores
      // NEXT_PUBLIC_* são embutidos no bundle do cliente em tempo de
      // build, não lidos em runtime), e o build "passaria" mesmo assim.
      // Precisa listar TODA NEXT_PUBLIC_* que o apps/web usa, não só as do
      // Google: as do Supabase e o DSN do Sentry entraram depois e
      // ficaram de fora até uma conferência do Dockerfile contra o que o
      // código de fato lê (`grep process.env.NEXT_PUBLIC_`) achar a
      // diferença. Faltar aqui é exatamente o bug que este comentário
      // descreve, só que silencioso duas vezes: cache do turbo serve um
      // bundle antigo E o valor congelado não dá pra corrigir em runtime.
      "env": [
        "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
        "NEXT_PUBLIC_GOOGLE_API_KEY",
        "NEXT_PUBLIC_GOOGLE_APP_ID",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
