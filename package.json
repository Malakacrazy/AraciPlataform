{
  "name": "araci-plataforma",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@12.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "db:generate": "npm run generate --workspace=packages/db",
    "db:migrate": "npm run migrate:dev --workspace=packages/db",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=packages/db",
    "db:local": "npm run db:local:start --workspace=packages/db",
    "check:deploy-config": "node scripts/check-deploy-config.mjs",
    "smoke-test:api": "npm run smoke-test --workspace=apps/api",
    "smoke-test:web": "npm run smoke-test --workspace=apps/web",
    "smoke-test": "npm run smoke-test:api && npm run smoke-test:web"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "esbuild@0.28.1": true,
    "xsd-schema-validator": false,
    "libxmljs2@0.37.0": true
  },
  "devDependencies": {
    "turbo": "^2.10.9"
  }
}
