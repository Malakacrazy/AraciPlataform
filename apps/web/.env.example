NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Quem pode logar (checado no callback signIn de apps/web/src/lib/auth.ts
# — o `hd` acima é só uma dica de UI, não é enforcement). Domínios inteiros
# em ALLOWED_EMAIL_DOMAINS, exceções pontuais (ex.: consultor externo) em
# ALLOWED_EMAILS. Ambos aceitam lista separada por vírgula.
ALLOWED_EMAIL_DOMAINS="studioaraci.com.br"
ALLOWED_EMAILS=""
# apps/web não fala com o Postgres diretamente mais — toda lógica de
# negócio vive em apps/api. Este é o único segredo compartilhado entre os
# dois (diferente de NEXTAUTH_SECRET); precisa ser IDÊNTICO ao
# INTERNAL_API_SECRET em apps/api/.env.
API_URL="http://localhost:3001"
INTERNAL_API_SECRET="generate-with: openssl rand -base64 32"
# Autorização incremental de Drive/Calendar (fora do login do NextAuth,
# ver apps/web/src/lib/google-client.ts) roda inteira no navegador — por
# isso precisa do prefixo NEXT_PUBLIC_, que o Next.js injeta no bundle do
# cliente. Nenhum desses três valores é secreto por natureza: client ID e
# API key (restrita por referrer/API no Cloud Console) e número do
# projeto já aparecem em texto claro em qualquer chamada OAuth/Picker do
# navegador.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="" # mesmo valor de GOOGLE_CLIENT_ID acima
NEXT_PUBLIC_GOOGLE_API_KEY="" # Cloud Console → Credentials → API key, restrita à Picker API
NEXT_PUBLIC_GOOGLE_APP_ID="" # número do projeto (Cloud Console → IAM & Admin → Settings)

# Login do convidado do quadro (colaboração no moodboard tldraw, ver
# WhiteboardGuest no schema) -- app OIDC próprio no Logto
# (logto.io/console ou self-hosted), audiência separada de staff
# (NextAuth/Google Workspace) e cliente/consultor (magic link próprio).
# Sem prefixo NEXT_PUBLIC_: só usado nos route handlers
# api/quadro/authorize|callback, nunca no bundle do navegador.
LOGTO_ENDPOINT="" # ex.: https://SEU-TENANT.logto.app
LOGTO_APP_ID=""
LOGTO_APP_SECRET=""

# Sincronização ao vivo do quadro tldraw entre quem está olhando ao mesmo
# tempo (broadcast puro, nenhuma tabela do Supabase envolvida -- ver
# lib/supabaseRealtime.ts). NEXT_PUBLIC_ porque roda no navegador; a
# "chave anônima" do Supabase é feita pra ser pública, protegida pelas
# regras do canal, não um segredo como GOOGLE_CLIENT_SECRET acima.
NEXT_PUBLIC_SUPABASE_URL="" # Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY="" # Supabase → Project Settings → API → anon public key

# Rastreamento de erro (bloqueador 09 da auditoria) -- vazio é um no-op
# seguro. SENTRY_DSN cobre o servidor (src/instrumentation.ts);
# NEXT_PUBLIC_SENTRY_DSN cobre o navegador (src/instrumentation-client.ts)
# -- precisa do prefixo porque é embutido no bundle do cliente em tempo
# de build, mesmo motivo dos NEXT_PUBLIC_GOOGLE_* acima. Mesmo DSN nos
# dois, copiado de sentry.io > Settings > Projects > (seu projeto) >
# Client Keys (DSN).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
