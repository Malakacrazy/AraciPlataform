DATABASE_URL="postgresql://araci:araci_dev_password@localhost:5433/araci_dev"
PORT=3001
# Segredo compartilhado só entre apps/web e apps/api — diferente de
# NEXTAUTH_SECRET. Nunca exposto ao navegador. gerar com: openssl rand -base64 32
INTERNAL_API_SECRET="generate-with: openssl rand -base64 32"

# Defesa em profundidade contra o mesmo achado C-01 checado em
# apps/web/src/lib/auth.ts (callback signIn) — o JWT interno normalmente
# só existe pra quem já passou por aquele callback, mas o guard confere
# de novo aqui antes de provisionar a conta, pro caso de o token chegar
# por outro caminho. Mesmo formato de lista separada por vírgula.
ALLOWED_EMAIL_DOMAINS="studioaraci.com.br"
ALLOWED_EMAILS=""

# Certificado A1 pra emissão de NFS-e (nfewizard-io) -- NUNCA um valor
# real aqui, e o .pfx em si nunca deve ser commitado (ver .gitignore,
# *.pfx/*.p12). NFSE_CERTIFICATE_CPFCNPJ precisa ser exatamente o CNPJ
# real do certificado (a lib confere isso antes de tentar emitir) --
# rode POST /v1/fiscal/nfse/inspecionar-certificado pra conferir.
NFSE_CERTIFICATE_PATH="path/to/certificado.pfx"
NFSE_CERTIFICATE_PASSWORD="senha-do-certificado"
NFSE_CERTIFICATE_UF="SP"
NFSE_CERTIFICATE_CPFCNPJ="00000000000000"

# Cobrança (Boleto + Pix) via Asaas -- NUNCA um valor real aqui.
# ASAAS_ENV ausente (ou != "production") cai em sandbox por padrão, nunca
# o contrário. ASAAS_WEBHOOK_AUTH_TOKEN é gerado por nós (ex.: openssl
# rand -hex 32) e configurado igual na Asaas ao criar o webhook -- ela
# ecoa esse valor de volta no header asaas-access-token de cada
# notificação, é assim que v1/billing/asaas/webhook confirma que a
# chamada é legítima.
ASAAS_ENV="sandbox"
ASAAS_API_KEY="sua-chave-de-api-asaas"
ASAAS_WEBHOOK_AUTH_TOKEN="generate-with: openssl rand -hex 32"
