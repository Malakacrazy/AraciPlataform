// Skeleton data model for Fase 0 — covers the core entities of the four
// modules. Office does not duplicate Google Workspace data (no cached
// Drive file contents, no Calendar event bodies) — OfficeLink below only
// stores the external reference (id/url/title) needed to show a link in
// the UI; the source of truth stays in Drive/Calendar. Updated after the
// Fase 0 discovery answers confirmed the real 5-stage PEP methodology and
// pricing engine — see docs/fase-0/decisoes-pos-descoberta.md and
// docs/fase-0/data-model.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// The 5 stages of the studio's real PEP (Plano de Execução de Projeto),
// adapted from RIBA Plan of Work 2020 — see docs/fase-0/PEP_Interior.md.
// Not every project contracts every stage (see ProjectPhase.contracted /
// ProposalStage.contracted).
enum ProjectStageName {
  CAPTACAO_ALINHAMENTO
  BRIEFING
  CRIACAO_CONCEITO
  DETALHAMENTO_ACABAMENTOS
  EXECUTIVO
}

enum OfficeLinkProvider {
  DRIVE
  CALENDAR
  GMAIL
}

enum OfficeLinkEntityType {
  PROJECT
  CLIENT
}

enum ActivityEntityType {
  PROJECT
  CLIENT
  OPPORTUNITY
}

// Tenant: the architecture firm using the platform. Every domain record
// hangs off an Account so the schema supports multiple firms later
// without a redesign, even though Giulia is the only tenant today.
model Account {
  id             String   @id @default(cuid())
  name           String
  cnpj           String?
  // "MEI" | "ME" — MEI tributa por valor fixo mensal (DAS-MEI), sem Fator
  // R; Fator R e Simples Nacional (Anexo III/V) só passam a valer quando
  // o estúdio migra pra ME. Ver docs/fase-0/decisoes-pos-descoberta.md #4
  // -- Studio Araci é MEI hoje, com migração pra ME prevista.
  taxRegime      String   @default("MEI")
  taxRegimeAnexo String? // "III" | "V" — só relevante quando taxRegime = "ME"
  fatorRPercent  Decimal? // last computed folha/receita 12m ratio, for the Fator R simulator
  createdAt      DateTime @default(now())

  // Lacuna da matriz (LGPD, "automação de retenção/expurgo") -- nulo por
  // padrão (= desligado): o prazo é decisão de negócio/jurídica de quem
  // administra a conta, não um número que o código deveria inventar. Só
  // quando preenchido (tela de Financeiro & Fiscal) o DataRetentionCron
  // passa a avaliar clientes desta conta. Não é um comando de exclusão --
  // ver ClientsService.anonymizeClient: o cron só NOTIFICA um admin sobre
  // candidatos, quem clica em "Anonimizar" continua sendo uma pessoa.
  dataRetentionMonths Int?

  // Lacuna da matriz (NFS-e dentro do fluxo real) -- "homologacao" por
  // padrão, sempre. Trocar pra "producao" é decisão explícita de quem
  // administra a conta (tela de Financeiro & Fiscal via PATCH /account),
  // nunca uma variável de ambiente -- emitir de verdade é um documento
  // fiscal real, e a própria lib usada (@nfewizard/nfse) ainda tem uma
  // issue aberta e sem solução definitiva sobre qual perfil de
  // assinatura XML a SEFIN Nacional aceita (ver
  // docs/fase-0/decisoes-pos-descoberta.md #4). Ligar "producao" aqui é
  // a permissão pra tentar, não uma prova de que a assinatura funciona
  // lá -- ver NfseService.emitirParaFatura.
  nfseAmbiente String @default("homologacao") // "homologacao" | "producao"

  // Lacuna da matriz (Reforma Tributária/IBS-CBS) -- totTrib da NFS-e é só
  // disclosure (Lei da Transparência Fiscal 12.741/2012, não muda o valor
  // cobrado/recolhido), mas ficava zerado porque não havia alíquota
  // efetiva confirmada (ver decisoes-pos-descoberta.md #4). Default
  // 0,70% = fase de teste 2026 da LC 214/2025 (0,9% CBS + 0,1% IBS) já com
  // a redução de 30% pra arquitetura/engenharia (ME) -- fonte é uma
  // estimativa (AI Overview do Google, não confirmada por contador),
  // aprovada explicitamente pelo usuário como suficiente pra um campo só
  // de disclosure. Cronograma sobe até 2033 (ver LayoutDPS totTrib em
  // nfse-invoice-dps.ts) -- campo de conta, não constante no código, pra
  // o próprio estúdio atualizar ano a ano sem precisar de deploy.
  cbsIbsEffectiveRatePercent Decimal @default(0.0070)

  // Abas 01/02 da planilha de precificação (docs/fase-0/Base_Precificacao
  // (fazer cópia).xlsx) -- inputs compartilhados pela fórmula de
  // tarifa/hora (crm/pricing.ts: calcularOverheadPorHora/
  // calcularTarifaHora), um valor só por conta (não por papel): margem-
  // alvo e carga tributária se aplicam igual a todo RoleRate calculado; a
  // capacidade produtiva (dias úteis × horas/dia × pessoas ativas) define
  // as horas faturáveis do ESTÚDIO, usadas pra ratear StudioFixedCost em
  // overhead/hora. Defaults reproduzem o baseline da planilha (30%
  // margem, 21 dias, 8h/dia, 1 pessoa) até calibração real.
  pricingMarginPercent        Decimal @default(0.30)
  pricingTaxBurdenPercent     Decimal @default(0)
  pricingBusinessDaysPerMonth Int     @default(21)
  pricingBillableHoursPerDay  Decimal @default(8)
  pricingActiveStaffCount     Decimal @default(1)

  users                 User[]
  clients               Client[]
  projects              Project[]
  products              Product[]
  externalCollaborators ExternalCollaborator[]
  whiteboardGuests      WhiteboardGuest[]
  roleRates             RoleRate[]
  officeLinks           OfficeLink[]
  activities            Activity[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  expenses              Expense[]
  studioFixedCosts      StudioFixedCost[]
  requiredDocumentTypes RequiredDocumentType[]
}

// Aba 01 ("Custos Fixos do Estúdio") -- item por item (aluguel, software,
// contador...), não só um total, porque é assim que o estúdio de fato
// mantém isso ao longo do tempo (ajustar o aluguel quando reajusta,
// adicionar uma licença nova), igual ao padrão já usado em Expense pra
// despesa pontual -- aqui é despesa RECORRENTE mensal, sem status pago/
// pendente (não é um lançamento de caixa, é um pressuposto de cálculo).
// A soma de monthlyAmount vira StudioFixedCosts.totalMonthlyFixedCosts em
// calcularOverheadPorHora (crm/pricing.ts).
model StudioFixedCost {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])
  description   String
  monthlyAmount Decimal
  createdAt     DateTime @default(now())

  // Achado do Apêndice B da auditoria de 30 ago 2026 ("Quase nenhuma FK
  // tinha índice", reaberto nos models criados depois da varredura
  // original): FK sem índice.
  @@index([accountId])
}

// Hourly rate per role, already net of overhead/margin/tax (the output of
// the pricing spreadsheet's "tarifa/hora" calculation, aba 02). `role`
// stays a free string (not an enum) since the team's real roster will
// vary; the canonical naming reconciled between PEP_Interior.md and the
// pricing sheet lives in apps/web/src/lib/roles.ts (CANONICAL_ROLES) —
// see decisoes-pos-descoberta.md, item 2, for the reasoning.
//
// grossSalary/payrollBurdenPercent/billableHoursPerMonth são opcionais e
// nulos juntos -- as duas formas de preencher hourlyRate continuam
// válidas: (a) digitar a tarifa final direto (ex.: freelancer com valor
// já fechado, sem salário/encargos que façam sentido calcular), ou (b)
// preencher os três campos de compensação, e o backend CALCULA
// hourlyRate via crm/pricing.ts (calcularTarifaHora) em vez de aceitar o
// valor digitado -- ver RoleRatesService.upsertRoleRate. Guardados (não
// só usados uma vez e descartados) pra reabrir o formulário já
// preenchido e recalcular quando custo fixo/margem/salário mudar.
model RoleRate {
  id                    String   @id @default(cuid())
  accountId             String
  account               Account  @relation(fields: [accountId], references: [id])
  role                  String
  hourlyRate            Decimal
  grossSalary           Decimal?
  payrollBurdenPercent  Decimal?
  billableHoursPerMonth Decimal?
  updatedAt             DateTime @updatedAt

  @@unique([accountId, role])
}

// Lacuna da matriz ("checklist de documentos obrigatórios por fase,
// amarrado ao gate do PEP") -- configurado uma vez por STAGE (não por
// ProjectPhase individual): o processo do estúdio é o mesmo em todo
// projeto ("Briefing sempre exige contrato assinado"), então cadastrar
// isto por projeto seria repetir a mesma configuração toda vez. Vazio
// (nenhuma linha pra um stage) = gate continua exatamente como sempre
// foi -- este recurso é aditivo, nunca muda o comportamento de uma conta
// que não configurou nada, mesmo espírito de Account.dataRetentionMonths/
// nfseAmbiente. documentType precisa bater exatamente (case-sensitive)
// com o OfficeLink.documentType marcado na fase real -- ver
// PhasesService.approvePhaseGate e o <datalist> em
// office-links-section.tsx, que sugere estes mesmos valores na hora de
// classificar um vínculo, pra reduzir divergência de digitação.
model RequiredDocumentType {
  id           String           @id @default(cuid())
  accountId    String
  account      Account          @relation(fields: [accountId], references: [id])
  stage        ProjectStageName
  documentType String
  createdAt    DateTime         @default(now())

  @@unique([accountId, stage, documentType])
}

model User {
  id                  String   @id @default(cuid())
  accountId           String
  account             Account  @relation(fields: [accountId], references: [id])
  email               String   @unique
  name                String
  role                String // admin | architect | designer | freelancer | ...
  // Nível de permissão real (admin | staff) -- distinto de `role` acima,
  // que é um título de precificação/exibição (ex.: "Arquiteto Sênior")
  // nunca checado por código nenhum. Antes deste campo não havia
  // permissão nenhuma: qualquer login autenticado enxergava e editava
  // tudo, inclusive financeiro e custo/hora de outra pessoa. `admin` só
  // é o default pra quem cria a conta pela primeira vez (ver
  // AuthService.ensureAccountAndUser); todo mundo depois entra como
  // `staff` e precisa ser promovido por um admin.
  accessLevel         String   @default("staff")
  specialty           String?
  costPerHour         Decimal?
  // Base para detectar sobrecarga no planejamento de alocação (Allocation,
  // abaixo) — quantas horas/semana esta pessoa efetivamente tem para
  // distribuir entre projetos. Default 40 (CLT integral); freelancers e
  // meio-período editam.
  weeklyCapacityHours Decimal  @default(40)
  googleId            String?  @unique
  // Sha-256 hex da chave de API (formato longa, alta entropia) que a
  // extensão Captura usa pra autenticar POST /v1/products direto do
  // navegador do colaborador -- nunca a chave em texto puro, que só existe
  // no momento da geração (ver UsersService.generateApiKey). Regenerar
  // sobrescreve o hash, invalidando a chave anterior implicitamente; não
  // há revogação por chave individual porque só existe uma por vez.
  apiKeyHash          String?  @unique
  createdAt           DateTime @default(now())

  timeEntries       TimeEntry[]
  projectMembership ProjectMember[]
  allocations       Allocation[]
  absences          Absence[]
  activities        Activity[]
  notifications     Notification[]
  assignedTasks     Task[]
  googleCredential  GoogleCredential?
  linkedOfficeLinks OfficeLink[]    @relation("OfficeLinkLinkedByUser")

  @@index([accountId])
}

// Refresh token do Google por usuário -- fundação pra sincronização via
// webhook (Calendar events.watch / Gmail users.watch), ainda não usada
// por nenhum job real (não existe watch() nem endpoint de callback do
// Google ainda, só esta persistência). Sempre criptografado em repouso
// (AES-256-GCM, ver google-credential-crypto.ts) porque é um segredo de
// longa duração que dá acesso à conta Google de verdade da pessoa,
// diferente de qualquer outro token deste projeto (todos os outros —
// sessão interna, link de apresentação, sessão de portal — são de vida
// curta). Nasce só quando o usuário conecta explicitamente em /team
// (nunca no login SSO normal, que continua sem escopo nenhum de
// Drive/Calendar/Gmail, de propósito).
model GoogleCredential {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  refreshTokenEnc String
  refreshTokenIv  String
  refreshTokenTag String
  scope           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// CRM: pessoa física/jurídica captada como lead ou já cliente
model Client {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  name            String
  document        String? // CPF/CNPJ
  // Sempre gravado em minúsculas (ver ClientsService) -- @unique sozinho
  // não pega "Foo@x.com" vs "foo@x.com" como duplicado, já que o
  // Postgres compara case-sensitive por padrão; a normalização na
  // escrita é o que fecha essa lacuna (achado A-05 da auditoria: o
  // login do portal busca por e-mail com findFirst, mas não havia
  // constraint nenhuma, então duas linhas com o mesmo e-mail tornavam o
  // login não-determinístico). NULL continua permitido (cliente sem
  // e-mail, ex.: só telefone) -- Postgres não considera dois NULLs
  // duplicados entre si, então múltiplos clientes sem e-mail convivem
  // normalmente.
  email           String?  @unique
  phone           String?
  source          String? // site | whatsapp | instagram | indicacao | email | telefone
  createdAt       DateTime @default(now())
  // Cliente correspondente criado na Asaas na primeira cobrança deste
  // Client (ver billing/asaas-client.ts) -- cacheado pra não recriar um
  // customer novo na Asaas a cada fatura do mesmo cliente.
  asaasCustomerId String?  @unique

  // Lacuna da matriz (LGPD) -- consentedAt só é setado pelo formulário
  // público de lead (LeadsService), a única captação sem relação real já
  // estabelecida antes da coleta; um cliente cadastrado pela equipe
  // (base legal é a relação contratual em si, não consentimento) fica
  // null aqui de propósito, não é "consentimento faltando". anonymizedAt
  // marca quando ClientsService.anonymize rodou -- name/email/phone/
  // document já viram placeholder nesse momento; o registro em si
  // sobrevive (Invoice/Opportunity/Project ligados continuam existindo,
  // é o histórico fiscal que a anonimização precisa preservar).
  consentedAt  DateTime?
  anonymizedAt DateTime?

  opportunities Opportunity[]
  projects      Project[]
  magicLinks    ClientMagicLink[]
  sessions      ClientSession[]

  @@index([accountId])
}

// Login de cliente por magic link -- pedido de acesso, curto e de uso
// único. token vem de crypto.randomUUID() (mesma origem de
// PresentationLink.token), não do id/cuid: cuid existe pra unicidade,
// não foi desenhado pra ser imprevisível como credencial de portador. Um
// pedido novo invalida qualquer link anterior ainda não consumido do
// mesmo cliente (ver ClientPortalService.requestMagicLink) -- só um link
// vivo por vez, mesmo espírito do "gerar de novo revoga o anterior" já
// usado em PresentationLink.
model ClientMagicLink {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  // Achado A55 da auditoria de 30 ago 2026: FK sem índice, e
  // requestMagicLink faz deleteMany por clientId a cada pedido de link.
  @@index([clientId])
}

// Sessão de cliente já autenticado (depois de consumir um
// ClientMagicLink) -- token opaco guardado num cookie httpOnly pelo
// apps/web, verificado aqui pelo próprio valor (mesmo modelo de
// "token na tabela é a credencial" do PresentationLink/ClientMagicLink
// acima), não um JWT decodificado no lado do apps/web. Existe separado
// do magic link porque tem vida bem mais longa (dias, não minutos) e
// pode ser usado repetidas vezes, diferente do link de e-mail, que é de
// uso único.
model ClientSession {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Achado A55 da auditoria de 30 ago 2026: FK sem índice.
  @@index([clientId])
}

// Lacuna da matriz ("colaboração com consultores externos") -- a própria
// auditoria chamou isso de "o item mais delicado do plano inteiro",
// porque não existe hoje nenhuma primitiva de autorização por projeto: um
// terceiro nível em User.accessLevel só seria seguro se TODA rota
// existente passasse a checar participação, e uma rota esquecida
// prometeria um escopo que não existe. Solução adotada em vez disso:
// consultor externo nunca vira User -- é uma identidade totalmente
// separada (mesma separação que Client já tem hoje), endereçável só por
// um portal próprio, minúsculo e só-leitura (ver collaborator-portal/).
// Sem superfície compartilhada com o resto da API, não tem como uma rota
// interna "esquecer" de checar isso -- o consultor simplesmente não fala
// com ela. Login por magic link (mesmo mecanismo do ClientMagicLink/
// ClientSession acima) -- convite explícito de um admin, nunca
// autoprovisionado por domínio de e-mail (diferente do fluxo de staff).
model ExternalCollaborator {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  projectAccess CollaboratorProjectAccess[]
  magicLinks    CollaboratorMagicLink[]
  sessions      CollaboratorSession[]

  // Achado do Apêndice B da auditoria de 30 ago 2026: FK sem índice.
  @@index([accountId])
}

// O convite em si -- criado por um admin (ver CollaboratorsService) ANTES
// do consultor logar pela primeira vez. Sem uma linha aqui pra um
// projeto, o consultor não vê aquele projeto no portal, mesmo já
// autenticado (ver CollaboratorPortalService.listProjects/getProject) --
// é o que torna "escopado por projeto" verificável e não só prometido.
model CollaboratorProjectAccess {
  id             String               @id @default(cuid())
  collaboratorId String
  collaborator   ExternalCollaborator @relation(fields: [collaboratorId], references: [id])
  projectId      String
  project        Project              @relation(fields: [projectId], references: [id])
  invitedAt      DateTime             @default(now())

  @@unique([collaboratorId, projectId])
  // Achado do Apêndice B: o unique acima começa por collaboratorId, então
  // não serve pra busca por projectId sozinho (CollaboratorsService.
  // listForProject filtra só por ela).
  @@index([projectId])
}

// Mesmo modelo exato de ClientMagicLink, só que pra ExternalCollaborator
// -- ver comentário lá (TTL de 15min, uso único, um pedido novo invalida
// qualquer link anterior ainda não consumido). Duplicado em vez de
// generalizado de propósito: são dois fluxos de autenticação distintos
// (cliente vs. consultor), e misturar os dois numa tabela polimórfica
// arriscaria o código de login do cliente, já testado e em produção, só
// pra evitar repetir ~6 campos.
model CollaboratorMagicLink {
  id             String               @id @default(cuid())
  collaboratorId String
  collaborator   ExternalCollaborator @relation(fields: [collaboratorId], references: [id])
  token          String               @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime             @default(now())

  // Achado do Apêndice B: FK sem índice.
  @@index([collaboratorId])
}

// Mesmo modelo exato de ClientSession -- ver comentário lá e em
// CollaboratorMagicLink acima pro porquê da duplicação deliberada.
model CollaboratorSession {
  id             String               @id @default(cuid())
  collaboratorId String
  collaborator   ExternalCollaborator @relation(fields: [collaboratorId], references: [id])
  token          String               @unique
  expiresAt      DateTime
  createdAt      DateTime             @default(now())

  // Achado do Apêndice B: FK sem índice.
  @@index([collaboratorId])
}

// CRM: oportunidade no pipeline (kanban)
model Opportunity {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  title          String // ex.: "Apto Vila Madalena" — vira Project.name na conversão automática, sem redigitação
  stage          String
  feeModel       String // hora_tecnica (only one in real use today) | percentual_cub | valor_m2 | fixo | recorrente — see decisoes-pos-descoberta.md #2
  estimatedValue Decimal?
  wonAt          DateTime?
  lostAt         DateTime?
  // Obrigatório junto de lostAt -- ver OpportunitiesService.markLost. Só
  // dá pra marcar perdida por um endpoint dedicado (não o PATCH genérico)
  // exatamente pra tornar essa exigência impossível de contornar, mesmo
  // padrão de approvalChannel em ProjectPhase.
  lostReason     String?
  // Preenchido só pelo formulário público de captação de lead
  // (LeadsService.submitLead) -- a mensagem que o próprio visitante
  // escreveu antes de qualquer contato humano. Nunca setado pelo
  // fluxo autenticado normal de criar/editar oportunidade (isso já tem
  // a timeline de Activity pra notas).
  leadMessage    String?
  createdAt      DateTime  @default(now())

  // Lacuna da matriz (portal pré-venda) -- pergunta do prospecto sobre a
  // proposta, lida pela equipe. Mesmo padrão de ProductSpecification.
  // clientComment (campo livre único, não uma thread) -- Activity não
  // serve aqui porque Activity.authorId exige um User de verdade, e o
  // prospecto não é um.
  prospectComment String?

  proposals Proposal[]
  project   Project?

  @@index([clientId])
}

// Value is the final computed price (aba 05 "PREÇO FINAL DE PROPOSTA");
// complexityMultiplier and packageDiscountPercent are carried alongside it
// so the breakdown stays inspectable without recomputing from ProposalStage.
model Proposal {
  id                     String      @id @default(cuid())
  opportunityId          String
  opportunity            Opportunity @relation(fields: [opportunityId], references: [id])
  value                  Decimal
  status                 String // draft | sent | signed | expired
  complexityMultiplier   Decimal? // 0.70x–1.50x, from the 5-dimension complexity score (aba 04)
  packageDiscountPercent Decimal? // 10% when 4+ stages are contracted together (aba 05)
  // Recalcular sempre cria uma proposta nova em vez de editar a existente
  // (ver comentário em ProposalsController) -- version/previousVersion
  // tornam essa cadeia explícita em vez de só "várias Proposal soltas na
  // mesma Opportunity sem ordem". Auto-incrementado em createProposal();
  // a versão anterior que ainda não tinha sido assinada vira "expired"
  // automaticamente (não faz sentido duas versões da mesma proposta
  // ainda assináveis ao mesmo tempo) -- uma já assinada nunca é tocada,
  // porque pode ser um aditivo/renegociação que convive com o contrato
  // aceito.
  version                Int         @default(1)
  previousVersionId      String?     @unique
  previousVersion        Proposal?   @relation("ProposalVersion", fields: [previousVersionId], references: [id])
  nextVersion            Proposal?   @relation("ProposalVersion")
  // Assinatura de verdade via ZapSign (não um botão "marcar como
  // assinada" clicado por alguém da equipe) -- zapsignDocToken correlaciona
  // o webhook (ver ZapSignWebhookController) de volta pra este registro;
  // zapsignSignUrl é a página de assinatura hospedada pela própria
  // ZapSign, dada à equipe pra compartilhar com o cliente (a plataforma
  // nunca hospeda a UI de assinatura em si). signerName/signedAt são
  // preenchidos só quando o webhook confirma doc_signed, nunca pelo
  // endpoint autenticado da equipe.
  zapsignDocToken        String?     @unique
  zapsignSignUrl         String?
  signerName             String?
  sentAt                 DateTime?
  signedAt               DateTime?

  stages ProposalStage[]
}

// One row per PEP stage in a proposal — mirrors the spreadsheet's
// "Configurador" (aba 05): which stages are contracted, their baseline
// hours, and hours/cost after the complexity multiplier.
model ProposalStage {
  id            String           @id @default(cuid())
  proposalId    String
  proposal      Proposal         @relation(fields: [proposalId], references: [id])
  stage         ProjectStageName
  contracted    Boolean          @default(true)
  baseHours     Decimal
  adjustedHours Decimal
  baseCost      Decimal
  adjustedCost  Decimal

  @@unique([proposalId, stage])
}

// ERP Arquitetura: projeto ativo, geralmente criado a partir de uma
// Opportunity ganha (conversão automática, sem redigitação)
model Project {
  id            String       @id @default(cuid())
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id])
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id])
  opportunityId String?      @unique
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  name          String
  status        String
  feeModel      String
  createdAt     DateTime     @default(now())

  phases             ProjectPhase[]
  members            ProjectMember[]
  timeEntries        TimeEntry[]
  invoices           Invoice[]
  areas              Area[]
  moodboards         Moodboard[]
  presentationLink   PresentationLink?
  allocations        Allocation[]
  expenses           Expense[]
  collaboratorAccess CollaboratorProjectAccess[]

  @@index([accountId])
  @@index([clientId])
}

// Lado da saída do caixa -- achado da auditoria: Financeiro só modelava
// o que entra (Invoice), nunca o que sai (subcontratado, software,
// aluguel, material). projectId opcional -- null é despesa de estrutura
// do estúdio, não amarrada a nenhum projeto (aluguel, ferramentas); com
// projeto é o custo externo real de entregar aquele projeto específico
// (diferente de TimeEntry × User.costPerHour, que é custo de mão de obra
// interna, não uma saída de caixa de verdade). category é string livre
// (mesmo padrão de RoleRate.role/Client.source) -- o roster real de
// categorias vai variar, não vale travar num enum. Só duas situações
// (pendente/paga), mais simples que Invoice (pendente/emitida/paga):
// não existe um equivalente de "emitida" (NFS-e) do lado de quem paga.
model Expense {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id])
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  description String
  category    String
  amount      Decimal
  status      String // pendente | paga
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([accountId])
  @@index([projectId])
}

// Planejamento de capacidade: quem está previsto para trabalhar em qual
// projeto, quantas horas/semana, entre quais datas -- para alocar a
// equipe olhando pra frente (prazos futuros), não só registrar o que já
// aconteceu. Diferente de TimeEntry (horas já trabalhadas, medidas) e de
// ProjectMember (só diz "faz parte do time do projeto", sem tempo/data).
// hoursPerWeek é um compromisso planejado, não uma medição.
model Allocation {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  hoursPerWeek Decimal
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([projectId])
}

// Lacuna da matriz ("calendário de férias/ausências"): período em que
// uma pessoa não está disponível pra trabalho -- férias, licença,
// atestado. `type` é string livre (mesmo padrão de Client.source/
// Expense.category), não um enum travado, porque o rol real do estúdio
// pode crescer. Existe pra ENTRAR na mesma máquina de sweep-line que já
// calcula carga semanal (ver apps/web/src/lib/allocations.ts) -- uma
// ausência ativa reduz disponibilidade real, não é só um registro
// decorativo separado do planejamento.
model Absence {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  startDate DateTime
  endDate   DateTime
  type      String   @default("ferias") // ferias | licenca | atestado | ...
  createdAt DateTime @default(now())

  @@index([userId])
}

// A stage of the PEP applied to a specific project. `approvedAt` /
// `approvalChannel` record the formal gate approval the PEP requires
// (§3.2: written approval only — email counts, WhatsApp does not) before
// the next stage can start and before this stage can be invoiced.
model ProjectPhase {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id])
  stage           ProjectStageName
  contracted      Boolean          @default(true) // not every project contracts every stage
  order           Int
  startDate       DateTime?
  dueDate         DateTime?
  budget          Decimal?
  approvedAt      DateTime?
  approvalChannel String? // "email" | "reuniao_presencial" — WhatsApp is not a valid gate approval per the PEP

  tasks       Task[]
  timeEntries TimeEntry[]
  invoices    Invoice[]
  officeLinks OfficeLink[]
}

// Existia no schema desde o início (init migration) sem controller, sem
// service, sem tela nenhuma -- achado da auditoria ("Task model is dead
// code"). assigneeId já existia mas era uma coluna solta, sem
// constraint de FK nenhuma (corrigido aqui, virou relação de verdade).
model Task {
  id          String       @id @default(cuid())
  phaseId     String
  phase       ProjectPhase @relation(fields: [phaseId], references: [id])
  title       String
  assigneeId  String?
  assignee    User?        @relation(fields: [assigneeId], references: [id])
  status      String // a_fazer | em_andamento | concluida
  order       Int          @default(0)
  dueDate     DateTime?
  // Preenchido só como efeito de status virar "concluida" (mesmo padrão
  // de Invoice.paidAt/ProjectPhase.approvedAt) -- nunca aceito como input
  // direto.
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  // Dependência entre tarefas -- auto-relação m:n implícita. dependsOn =
  // "isso só pode ser concluído depois de"; blocks é o lado reverso
  // (quem depende de mim). Validado na service layer: sem ciclos (DFS ao
  // adicionar uma aresta) e, ao marcar "concluida", todo dependsOn
  // precisa já estar concluído -- sem isso, dependência seria só um
  // rótulo decorativo, não uma regra de verdade.
  dependsOn Task[] @relation("TaskDependency")
  blocks    Task[] @relation("TaskDependency")

  @@index([phaseId])
}

model ProjectMember {
  id            String  @id @default(cuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id])
  userId        String
  user          User    @relation(fields: [userId], references: [id])
  roleOnProject String?

  @@unique([projectId, userId])
}

// Timesheet: horas faturáveis/não faturáveis por colaborador, projeto e fase
model TimeEntry {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id])
  phaseId      String?
  phase        ProjectPhase? @relation(fields: [phaseId], references: [id])
  date         DateTime
  hours        Decimal
  billable     Boolean       @default(true)
  activityType String // projeto | administrativo | comercial
  approvedAt   DateTime?
  approvedById String?

  // Achados A2+A7 da auditoria de 30 ago 2026 (auditoria-2026-08-30-detalhada.md):
  // invoiceId (em vez de reusar "uma fatura por fase" como o único
  // invariante) é o que permite uma fatura COMPLEMENTAR no mesmo estágio
  // quando horas são aprovadas depois do primeiro faturamento -- sem
  // isso, essas horas ficavam permanentemente não faturáveis (guard
  // PHASE_ALREADY_INVOICED barrava qualquer fatura nova pro mesmo
  // phaseId). createHourlyInvoice agora seleciona por
  // `invoiceId: null`, não mais só por phaseId (ver invoices.service.ts).
  // approvedHourlyRate congela a tarifa do papel NO MOMENTO da aprovação
  // -- sem isso, horas de meses atrás eram recalculadas pela tarifa de
  // HOJE quando finalmente faturadas, mudando o valor cobrado do cliente
  // depois do trabalho já feito.
  invoiceId          String?
  invoice            Invoice?  @relation(fields: [invoiceId], references: [id])
  approvedHourlyRate Decimal?

  @@index([userId])
  @@index([projectId])
  @@index([phaseId])
  @@index([invoiceId])
}

// Billing is per stage completed and approved (PEP §0, "Forma de
// medição"), so an invoice usually ties to the ProjectPhase whose gate was
// just approved. phaseId is optional to still allow non-stage invoices
// (e.g. FF&E budget draft-invoices from modules/ffe/approveCartToInvoiceDraft).
model Invoice {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id])
  phaseId    String?
  phase      ProjectPhase? @relation(fields: [phaseId], references: [id])
  amount     Decimal
  status     String // pendente | emitida | paga
  // Preenchido tanto pelo registro manual (PATCH direto, fluxo antigo de
  // "emitida via parceiro fiscal") quanto pela emissão automática abaixo
  // (NfseService.emitirParaFatura seta como a própria chaveAcesso) --
  // continua sendo "o número que a usuária vê", venha de onde vier.
  nfseNumber String?
  dueDate    DateTime?
  issuedAt   DateTime?
  paidAt     DateTime?

  // Lacuna da matriz (NFS-e dentro do fluxo real, não só o teste mecânico
  // em NfseController). chaveAcesso é o identificador único de verdade
  // da NFS-e Nacional -- @unique também serve de guarda de idempotência
  // (ver NfseService.emitirParaFatura: presença dela já significa
  // "emitida", barra reemissão antes de qualquer chamada à SEFIN).
  // nfseNumeroDps é derivado de forma estável a partir do próprio id da
  // fatura (não de timestamp) -- uma tentativa que falhar por queda de
  // rede e for reenviada cai no MESMO nDPS, pra SEFIN rejeitar como
  // duplicata em vez de autorizar duas DPS pra mesma fatura.
  // nfseAmbienteEmissao registra qual ambiente foi USADO nesta emissão
  // (histórico -- pode divergir de Account.nfseAmbiente se mudou depois).
  // nfseRejectionReason é o detalhe real da rejeição da SEFIN (achado da
  // auditoria: hoje isso é capturado e descartado, vira 502 genérico) --
  // persistido pra sobreviver a um refresh de página, limpo na próxima
  // emissão bem-sucedida.
  nfseChaveAcesso     String? @unique
  nfseIdDps           String?
  nfseNumeroDps       String?
  nfseAmbienteEmissao String?
  nfseRejectionReason String?

  // Arquivamento do XML assinado (emissão/cancelamento/substituição) no
  // Drive do projeto -- pedido direto do usuário: a NFS-e já vem com XML
  // assinado pronto na resposta da SEFIN (nfseXmlGZipB64/eventoXmlGZipB64),
  // e a lib até salva em disco, mas no container do Render isso é
  // efêmero (some no redeploy) e ninguém nunca lê de volta. Reaproveita o
  // pipeline de Drive já existente em vez do disco `araci-fiscal-xml`
  // (que ficava sem nenhum código escrevendo nele). Mesmo espírito de
  // nfseRejectionReason: nunca bloqueia a ação fiscal em si (a NFS-e já
  // está autorizada/cancelada de verdade na SEFIN nesse ponto -- falhar
  // a resposta por causa do Drive seria errado), só registra quando o
  // arquivamento falhou, pra não ficar silencioso. null = arquivado com
  // sucesso (ou ação fiscal ainda não tentada).
  nfseXmlArchiveError String?

  // Lacuna da matriz (NFS-e: cancelamento/substituição). Cancelamento
  // simples (evento e101101 da SEFIN Nacional) não emite nada novo, só
  // invalida a NFS-e atual -- nfseChaveAcesso continua com a chave
  // cancelada (histórico), nfseCanceladaEm marca que ela não vale mais.
  // Emitir de novo depois disso (NfseService.emitirParaFatura) é uma DPS
  // nova do zero, que limpa estes três campos. Substituição
  // (NfseService.substituirParaFatura) é diferente: emite a DPS corrigida
  // PRIMEIRO (chaveAcesso/idDps/numeroDps acima passam a ser os da NOVA),
  // só então cancela a antiga referenciando a nova (evento e105102,
  // chNFSeSubst) -- nfseChaveAcessoAnterior guarda essa chave substituída
  // pra auditoria, nunca fica null numa substituição concluída.
  nfseCanceladaEm               DateTime?
  nfseMotivoCancelamento        Int? // 1 (erro na emissão) | 2 (serviço não prestado) | 9 (outros) -- código da SEFIN Nacional
  nfseJustificativaCancelamento String?
  nfseChaveAcessoAnterior       String?

  // Cobrança (Boleto + Pix) via Asaas -- ver billing/. asaasPaymentId é o
  // id da cobrança na Asaas, usado pelo webhook pra achar de volta esta
  // Invoice quando o pagamento é confirmado. asaasInvoiceUrl é a página
  // hospedada pela Asaas (billingType UNDEFINED) onde o cliente escolhe
  // Boleto ou Pix -- não geramos QR code/boleto próprios, só linkamos.
  asaasPaymentId  String? @unique
  asaasInvoiceUrl String?

  // Reforma Tributária (IBS/CBS) — campos de preparo do modelo de dados,
  // recomendados desde a Fase 2 mesmo com 2026 sendo só o ano de testes
  // (split payment vira obrigatório em 2027). Deliberadamente sem lógica
  // de split payment ainda — só os campos, pra não represar a migração
  // de dado quando a obrigatoriedade chegar. Nulos até lá; o próprio
  // schema da NFS-e Nacional (LayoutDPS.InfDPS.IBSCBS) ainda trata isso
  // como campo opcional e pouco tipado (`any`) na lib usada para emissão
  // — o padrão real ainda não estabilizou.
  cstIbs     String? // Código de Situação Tributária do IBS
  cstCbs     String? // Código de Situação Tributária da CBS
  cClassTrib String? // Código de Classificação Tributária

  lines       InvoiceLine[]
  // Reverso de TimeEntry.invoiceId (ver comentário lá) -- não é "a mesma
  // coisa" que `lines`: lines é o resumo por papel gravado na criação da
  // fatura (histórico, sobrevive mesmo que a TimeEntry original seja
  // editada depois); timeEntries é o vínculo vivo usado só pra saber
  // quais horas já foram consumidas por qual fatura.
  timeEntries TimeEntry[]

  @@index([projectId])
  @@index([phaseId])
}

// Só existe para faturas de projeto hora_tecnica calculadas a partir de
// TimeEntry aprovada (ver InvoicesService.createHourlyInvoice) — uma
// linha por papel com horas apontadas naquele estágio, mesma ideia de
// ProposalStage (uma linha por estágio), mas aqui o agrupamento é por
// papel porque é isso que RoleRate precifica. Fatura com valor
// digitado à mão (outros feeModel, ou o carrinho de FF&E) não cria
// nenhuma linha.
model InvoiceLine {
  id         String  @id @default(cuid())
  invoiceId  String
  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  role       String
  hours      Decimal
  hourlyRate Decimal
  amount     Decimal
}

// FF&E: ambiente/área do projeto ao qual produtos são especificados
model Area {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  name      String // ex.: Sala de estar, Quarto principal, Cozinha

  specifications ProductSpecification[]

  @@index([projectId])
}

// FF&E: catálogo de produtos, populado manualmente ou via web scraper
model Product {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id])
  name         String
  supplier     String?
  price        Decimal?
  dimensions   String?
  finish       String?
  leadTimeDays Int?
  imageUrl     String?
  sourceUrl    String? // origem quando capturado via web scraper
  isGeneric    Boolean  @default(false) // placeholder quando o SKU ainda não foi escolhido
  createdAt    DateTime @default(now())

  // Categoria livre (mesmo padrão de RoleRate.role/Expense.category) --
  // usada pro rollup de orçamento por categoria dentro de um projeto (ver
  // FF&E da tela do projeto). Não trava em enum porque o roster real de
  // categorias do estúdio pode mudar.
  category String?

  // Variante = outro Product apontando pro produto "pai" via variantOfId
  // (ex.: mesmo sofá, acabamentos diferentes) -- não um model separado,
  // pra não duplicar a lógica de especificação/moodboard/Captura que já
  // trata "um Product" como a unidade especificável; uma variante É um
  // Product. Só um nível: uma variante não pode ter sua própria variante
  // -- FK sozinha não expressa isso, checado em ProductsService.
  variantOfId  String?
  variantOf    Product?  @relation("ProductVariants", fields: [variantOfId], references: [id])
  variantLabel String? // "Nogueira", "180cm", "Veludo azul" -- só faz sentido quando variantOfId está setado
  variants     Product[] @relation("ProductVariants")

  images ProductImage[]

  specifications ProductSpecification[]

  @@index([accountId])
}

// Galeria de fotos extras do produto -- imageUrl continua sendo a capa
// (é o campo que o Captura já manda; não renomeado pra não quebrar a
// extensão, que fica fora deste repo). Fotos adicionais só entram por
// aqui, cadastradas manualmente pela própria plataforma.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  // Achado do Apêndice B: FK ON DELETE CASCADE sem índice.
  @@index([productId])
}

// FF&E: linha do carrinho de compras — produto especificado em uma área,
// com preço/markup e aprovação do cliente. A soma das linhas aprovadas é
// o orçamento final (planilha de itens e valores) que flui para o ERP.
model ProductSpecification {
  id             String   @id @default(cuid())
  areaId         String
  area           Area     @relation(fields: [areaId], references: [id])
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  quantity       Int      @default(1)
  unitPrice      Decimal?
  markupPercent  Decimal?
  clientApproved Boolean  @default(false)
  clientComment  String?
  createdAt      DateTime @default(now())

  // Achado A49 da auditoria de 30 ago 2026: clientApproved carregava dois
  // significados ao mesmo tempo -- "o cliente aprovou pelo link público"
  // E "já foi faturado" (approveCartToInvoiceDraft usava
  // `clientApproved: false` como guarda de corrida do checkout). Como
  // FfeCart filtra `!clientApproved` pro carrinho, um item aprovado pelo
  // cliente sumia da lista de faturáveis PERMANENTEMENTE, mesmo sem
  // nenhum Invoice ter sido gerado -- não existia caminho de UI de volta.
  // invoicedAt separa os dois: clientApproved continua só "o cliente
  // aprovou" (sinal pra equipe saber que pode faturar), invoicedAt é a
  // guarda de corrida e o filtro real do carrinho.
  invoicedAt DateTime?

  @@index([areaId])
  @@index([productId])
}

// FF&E: prancha de apresentação — antes um canvas livre próprio
// (posição/tamanho de produto/amostra, ver MoodboardItem no histórico),
// agora um quadro tldraw embutido de verdade: desenho livre, texto,
// qualquer imagem, não só produtos do catálogo. `snapshot` é o
// TLStoreSnapshot inteiro (shapes + assets), salvo pelo cliente via
// debounce (ver MoodboardsService.saveSnapshot) -- Postgres continua
// sendo o sistema de registro; a sincronização ao vivo entre quem está
// olhando ao mesmo tempo passa por um canal Realtime do Supabase
// (ver TldrawSupabaseSync no frontend), nunca persistida lá — só
// retransmitida. Por projeto, não por Area — o estúdio pode montar mais
// de uma prancha para o mesmo ambiente (ex.: "Sala de Estar — Conceito
// 1/2").
model Moodboard {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  name      String
  createdAt DateTime @default(now())
  snapshot  Json?

  guestAccess WhiteboardGuestAccess[]
  comments    MoodboardComment[]

  // Achado A62 da auditoria de 30 ago 2026: a migration que criou este
  // model reintroduziu o problema de FK sem índice que a varredura
  // anterior tinha corrigido -- só criou índices UNIQUE, nenhum de FK.
  @@index([projectId])
}

// Chat por prancha, ao lado do desenho ao vivo -- tldraw cobre o canvas,
// isto cobre a conversa. Sem FK de verdade pro autor: User/Client/
// WhiteboardGuest são três tabelas diferentes, e Activity.authorId não
// serve aqui pelo mesmo motivo que não serve pro comentário de
// prospecto no portal (ver PublicPresentationService, achado documentado
// lá) -- exige um User de verdade, e nem cliente nem convidado são.
// authorName é um retrato do nome no momento do comentário, não uma
// referência viva (se a pessoa mudar de nome depois, comentários antigos
// mantêm o nome de quando foram escritos -- comportamento aceitável pra
// chat, não pra auditoria). Retransmitido ao vivo pelo mesmo canal
// Realtime do Supabase que sincroniza o canvas (ver
// TldrawSupabaseSync), além de persistido aqui.
model MoodboardComment {
  id          String    @id @default(cuid())
  moodboardId String
  moodboard   Moodboard @relation(fields: [moodboardId], references: [id], onDelete: Cascade)
  authorType  String // "user" | "client" | "guest"
  authorName  String
  body        String
  createdAt   DateTime  @default(now())

  // Achado A62: FK ON DELETE CASCADE sem índice -- cada listComments e
  // cada apagar de prancha (resolução do cascade) varria a tabela
  // inteira.
  @@index([moodboardId])
}

// Nova audiência que não é staff (sem conta Google Workspace) nem o
// cliente do projeto (sem CollaboratorPortalService, que é read-only e
// escopado a PROJETO inteiro) -- alguém convidado só pra colaborar num
// quadro específico. Autenticado via Logto (OIDC), não magic link
// próprio como ExternalCollaborator/Client: decisão explícita do
// usuário, não invenção desta sessão. logtoSubjectId fica null até o
// primeiro login bem-sucedido (convite por e-mail sempre vem antes,
// mesma ordem de ExternalCollaborator) -- depois disso, trava nesse
// subject específico, e-mail sozinho não basta mais pra provar
// identidade.
model WhiteboardGuest {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  email          String   @unique
  name           String
  logtoSubjectId String?  @unique
  createdAt      DateTime @default(now())

  access   WhiteboardGuestAccess[]
  sessions WhiteboardGuestSession[]

  // Achado A62: FK sem índice.
  @@index([accountId])
}

// O convite em si -- criado por um admin ANTES do convidado logar pela
// primeira vez (mesmo padrão de CollaboratorProjectAccess). Escopado ao
// QUADRO, não ao projeto inteiro -- convite mais estreito que o de
// consultor externo, de propósito: "colabora neste quadro" é uma
// concessão menor que "vê o projeto inteiro".
model WhiteboardGuestAccess {
  id          String          @id @default(cuid())
  guestId     String
  guest       WhiteboardGuest @relation(fields: [guestId], references: [id])
  moodboardId String
  moodboard   Moodboard       @relation(fields: [moodboardId], references: [id])
  invitedAt   DateTime        @default(now())

  @@unique([guestId, moodboardId])
  // Achado A62: o unique composto acima começa por guestId, então não
  // serve pra busca por moodboardId sozinho (listForMoodboard/
  // deleteMoodboard filtram por ela).
  @@index([moodboardId])
}

// Sessão própria da plataforma, não o cookie/JWT do Logto em si --
// mesmo raciocínio de ClientSession/CollaboratorSession: um token nesta
// tabela É a credencial, verificado aqui, sem exigir validação de JWKS a
// cada chamada. Nasce só depois que o login OIDC via Logto confirma a
// identidade (ver LogtoCallback em apps/web); Logto prova QUEM é a
// pessoa uma vez, esta tabela decide por quanto tempo ela continua
// autenticada na plataforma.
model WhiteboardGuestSession {
  id        String          @id @default(cuid())
  guestId   String
  guest     WhiteboardGuest @relation(fields: [guestId], references: [id])
  token     String          @unique
  expiresAt DateTime
  createdAt DateTime        @default(now())

  // Achado A62: FK sem índice.
  @@index([guestId])
}

// Link de apresentação: dá a um cliente (sem login, sem conta) acesso de
// visualização + aprovação/comentário a um projeto — "modo de
// apresentação via link único" do plano. `token` é o segredo na URL,
// gerado com crypto.randomUUID() no service (nunca reaproveita `id`/cuid
// — cuid existe para unicidade, não para ser imprevisível como
// credencial; ver PresentationLinksService). Um link por projeto — gerar
// de novo substitui o anterior (revogação implícita).
model PresentationLink {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id])
  token     String   @unique
  createdAt DateTime @default(now())
}

// Office: referência a um arquivo do Drive ou evento do Calendar vinculado
// a um Project ou Client. Sem FK direta para entityId — é polimórfico
// (Project ou Client conforme entityType) — o escopo de conta e a
// existência do alvo são validados na service layer, mesmo padrão já
// usado para escopar sub-recursos ao Project dono (ex.: Area).
model OfficeLink {
  id         String               @id @default(cuid())
  accountId  String
  account    Account              @relation(fields: [accountId], references: [id])
  entityType OfficeLinkEntityType
  entityId   String
  provider   OfficeLinkProvider
  externalId String // Drive fileId ou Calendar eventId
  url        String
  title      String
  createdAt  DateTime             @default(now())

  // Lacuna da matriz (gestão documental por projeto) -- taxonomia livre
  // (mesmo espírito de Client.source: rótulo, não enum no banco) só faz
  // sentido de verdade pra provider=DRIVE, mas não é restringido no
  // schema pelo mesmo motivo de OfficeLinkProvider já cobrir os três.
  // phaseId é uma FK real (ProjectPhase é tabela de verdade, ao contrário
  // de entityId acima, que é polimórfico) -- null quando o vínculo não é
  // de uma fase específica (ex.: pasta raiz do projeto, ou vínculo de
  // Client). visibleToClient é metadado por enquanto: o portal/link de
  // apresentação ainda não expõe documento nenhum (item "grande" da lista
  // de 11, deliberadamente adiado).
  documentType    String?
  phaseId         String?
  phase           ProjectPhase? @relation(fields: [phaseId], references: [id])
  visibleToClient Boolean       @default(false)

  // Achado A33 da auditoria de 30 ago 2026: a credencial de Drive é por
  // (app, usuário, arquivo) no escopo drive.file -- um arquivo escolhido
  // pelo Picker do usuário B não está na concessão do usuário A, então
  // resolver "qualquer admin conectado" pra verificar/baixar um vínculo
  // que outra pessoa criou faz o Drive responder 404 (sem grant) e o
  // código confundir isso com "arquivo apagado de verdade". Guarda quem
  // de fato criou o vínculo (nulo pra linhas antigas, migradas antes
  // deste campo existir, e pra pastas/XML provisionados pelo servidor
  // via ensureProjectFolderTree/archiveFiscalXml, cujo "dono" é só quem
  // resolveu a credencial na hora, não uma pessoa específica que
  // escolheu o arquivo) -- resolveDriveAccessToken passa a preferir a
  // credencial desta pessoa antes de cair no fallback de "qualquer
  // admin".
  linkedByUserId String?
  linkedByUser   User?   @relation("OfficeLinkLinkedByUser", fields: [linkedByUserId], references: [id])

  // Achado da auditoria: "hoje o link apodrece em silêncio" -- arquivo
  // movido/renomeado/excluído no Drive não derruba nada aqui, só some
  // silenciosamente do lado de lá. GoogleDriveService.checkBrokenLinks
  // (cron semanal + verificação sob demanda) preenche brokenAt quando o
  // Drive responde 404 pro externalId; lastCheckedAt existe pra saber se
  // um link nunca foi verificado (null) vs. verificado e ainda saudável
  // (preenchido, brokenAt null).
  brokenAt      DateTime?
  lastCheckedAt DateTime?

  @@index([accountId, entityType, entityId])
  // Achado A39 da auditoria de 30 ago 2026: FK criada sem índice, e é
  // exatamente a coluna pela qual o checklist de documentos obrigatórios
  // do gate consulta (phases.service.ts) -- sem isto era seq scan da
  // tabela inteira a cada abertura de fase/tentativa de aprovar gate.
  @@index([phaseId, brokenAt])
}

// Nota/atividade em texto livre anexada a Project, Client ou Opportunity
// -- mesmo padrão polimórfico do OfficeLink acima (accountId + entityType
// + entityId, sem FK direta pro alvo, escopo e existência validados na
// service layer). Existe porque nenhum desses três registros tinha
// histórico algum antes: nada registrava o que foi dito numa ligação ou
// quando algo mudou de mãos.
model Activity {
  id         String             @id @default(cuid())
  accountId  String
  account    Account            @relation(fields: [accountId], references: [id])
  entityType ActivityEntityType
  entityId   String
  authorId   String
  author     User               @relation(fields: [authorId], references: [id])
  body       String
  createdAt  DateTime           @default(now())

  // Achado A63 da auditoria de 30 ago 2026: collaborator-portal.service.ts
  // devolvia TODA Activity de um projeto pro consultor externo, inclusive
  // retroativa (escrita meses antes dele existir) e sem nenhum aviso pra
  // quem escreve a nota de que ela sai do estúdio. Default false (opt-in
  // explícito) segue o mesmo padrão de OfficeLink.visibleToClient --
  // preserva o comportamento seguro pra todo o histórico já existente.
  visibleToCollaborator Boolean @default(false)

  @@index([accountId, entityType, entityId])
}

// Contraparte in-app do que NotificationsService já manda por e-mail via
// Resend -- pra quem não está de olho na caixa de entrada (sino na Nav).
// Uma linha por destinatário, não por conta: cada admin marca a sua como
// lida sem afetar as outras. `projectId`/`opportunityId`/`clientId` ficam
// soltos (não um par entityType/entityId polimórfico como Activity/
// OfficeLink) porque cada gatilho sempre aponta pro mesmo tipo de alvo --
// generalizar antes de um terceiro tipo de alvo existir seria abstração
// sem uso real. `clientId` (DataRetentionCron, ver activities/) é esse
// terceiro -- se aparecer um quarto, vale reconsiderar o par polimórfico
// em vez de continuar empilhando coluna solta.
model Notification {
  id            String    @id @default(cuid())
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  type          String // "specification_approved" | "proposal_signed"
  title         String
  body          String?
  projectId     String?
  opportunityId String?
  clientId      String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, readAt])
}

// Trilha de auditoria "quem mudou o quê" -- diferente de Activity (nota em
// texto livre escrita por um humano) e de Notification (alerta pontual pro
// sino): esta tabela é preenchida sozinha pelo Prisma Client, via extensão
// registrada em PrismaService (ver audit/prisma-audit-extension.ts), não
// por chamada explícita de cada service. accountId é opcional só pelo
// paradoxo do bootstrap: no create do próprio primeiro Account do sistema,
// o id ainda não existe antes da escrita -- a extensão resolve isso
// apontando pro id recém-criado, ver comentário lá.
model AuditLog {
  id          String   @id @default(cuid())
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  // "user" | "client" | "system" -- client quando quem agiu foi um
  // Client pelo link de apresentação (sem User próprio); system quando não
  // há ator humano identificável (webhook da Asaas, bootstrap da conta).
  actorType   String
  actorId     String? // User.id quando actorType = "user"; id do Client quando "client"
  // Denormalizado no momento da escrita -- sobrevive mesmo se o User/Client
  // referenciado acima for removido depois, sem precisar de join nenhum
  // pra exibir "quem" na tela de log.
  actorEmail  String?
  action      String // "create" | "update" | "delete"
  entityType  String // nome do model Prisma (ex.: "Project")
  entityId    String
  // Campo de exibição (Project.name, Client.name, ...) capturado no
  // momento da escrita, só pros models onde existe um campo óbvio pra
  // isso -- null pro resto (ex.: ProjectPhase, TimeEntry), que a tela de
  // log mostra só como "entityType + id curto".
  entityLabel String?
  // update: { campo: { from, to } } só dos campos que de fato mudaram;
  // create/delete: snapshot completo no mesmo formato (from/to null).
  changes     Json?
  createdAt   DateTime @default(now())

  @@index([accountId, entityType, entityId])
  @@index([accountId, createdAt])
}
